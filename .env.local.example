# Backend media host (book covers under /media/). Use Django VM in production.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://django.orthodoxbookshop.asia

# Django Oscar API (server proxy + client-side hyperlinked country/basket URLs)
# OSCAR_API_URL=https://django.orthodoxbookshop.asia/api
# NEXT_PUBLIC_OSCAR_API_URL=https://django.orthodoxbookshop.asia/api

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe webhook (Dashboard → Webhooks → https://your-storefront/api/stripe/webhook
# Listen for payment_intent.succeeded). Required for Alipay/China fulfillment when
# the browser cannot return to the storefront.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Shared secret with Django OSCAR_FULFILLMENT_SECRET. Next.js webhook calls
# POST {OSCAR_API_URL}/checkout/fulfill-payment/ with header X-Fulfillment-Secret.
OSCAR_FULFILLMENT_SECRET=generate_a_long_random_string_here

# hCaptcha Configuration
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key_here

# Recommendation System LLM Configuration
RECOMMENDATIONS_LLM_API_KEY=your-api-key-here
RECOMMENDATIONS_LLM_BASE_URL=https://nano-gpt.com/api/v1
RECOMMENDATIONS_LLM_MODEL=gpt-4o-mini
RECOMMENDATIONS_LLM_CONCURRENCY=5
